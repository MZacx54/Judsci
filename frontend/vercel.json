{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://judsci-production-b036.up.railway.app/api/:path*"
        },
        {
            "source": "/admin",
            "destination": "https://judsci-production-b036.up.railway.app/admin/"
        },
        {
            "source": "/admin/",
            "destination": "https://judsci-production-b036.up.railway.app/admin/"
        },
        {
            "source": "/admin/:path*",
            "destination": "https://judsci-production-b036.up.railway.app/admin/:path*"
        },
        {
            "source": "/media/:path*",
            "destination": "https://judsci-production-b036.up.railway.app/media/:path*"
        },
        {
            "source": "/static/admin/:path*",
            "destination": "https://judsci-production-b036.up.railway.app/static/admin/:path*"
        },
        {
            "source": "/static/rest_framework/:path*",
            "destination": "https://judsci-production-b036.up.railway.app/static/rest_framework/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}